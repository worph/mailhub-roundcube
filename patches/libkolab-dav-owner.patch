             $this->owner = rawurldecode(end($path));
         } else {
             $rcube = rcube::get_instance();
-            $this->owner = $rcube->get_user_name();
+            $this->owner = $rcube->config->get("kolab_dav_owner") ?: $rcube->get_user_name();
         }
 
         return $this->owner;
@@ -150,7 +150,7 @@ class kolab_storage_dav_folder extends kolab_storage_folder
