+++ b/calendar/drivers/caldav/caldav_calendar.php
@@ -75,7 +75,12 @@ class caldav_calendar extends kolab_storage_dav_folder
             $this->subtype    = $this->storage->subtype;
             $this->alarms     = !isset($this->attributes['alarms']) || $this->attributes['alarms'];
 
-            if ($this->storage->get_namespace() == 'personal') {
+            // A calendar shared with this account (sabre/Baïkal reports the sharee as its
+            // owner, so it looks personal) has the rights of its share, not an owner's.
+            $shared_in = in_array($this->attributes['share-access'] ?? '',
+                [kolab_dav_client::SHARING_READ, kolab_dav_client::SHARING_READ_WRITE], true);
+
+            if ($this->storage->get_namespace() == 'personal' && !$shared_in) {
                 $this->rights = 'lrswikxteav';
